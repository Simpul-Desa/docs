# Salin berkas ini menjadi `.env`, lalu isi nilainya. `.env` tidak ter-commit.
# Keempatnya dibaca `docusaurus.config.js` saat build; kalau dikosongkan, nilai
# bawaan di berkas itu yang dipakai.

# Dasbor SIMPUL DESA. Bawaan: /docs/intro (dasbor belum punya URL terbit).
SIMPUL_URL_PORTAL=/docs/intro

# API yang sudah ter-deploy, dipakai di halaman /api/intro.
SIMPUL_URL_API=https://api-simpul-desa.up.railway.app

# Situs dokumentasi ini. Bawaan: / (rute relatif, benar di lokal dan produksi).
SIMPUL_URL_DOKUMENTASI=/

# Video demo / pengenalan SIMPUL DESA. Bawaan: https://drive.google.com
SIMPUL_URL_VIDEO=https://drive.google.com
